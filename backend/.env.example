# Copy this file to ".env" (in the project root or in backend/) and fill it in.
# On Replit, add these as Secrets instead; never commit a real .env file.

# Required: get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: leave empty to use the defaults (gemini-2.5-flash / gemini-embedding-001)
GEN_MODEL=
EMBED_MODEL=

# Optional: if set, the admin page and document endpoints require this password
ADMIN_PASSWORD=
